FROM node:22-slim
WORKDIR /app

RUN npm i -g pnpm

COPY package.json pnpm-workspace.yaml* tsconfig.base.json tsconfig.json ./
COPY libs ./libs
COPY apps ./apps

RUN pnpm install --ignore-scripts && pnpm -r run build

ENV PORT=3020
EXPOSE 3020

CMD ["node", "apps/infra-service/dist/apps/infra-service/src/main.js"]
