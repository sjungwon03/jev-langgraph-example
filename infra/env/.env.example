# ==============================================================================
# Proxmox MCP & LangGraph Infrastructure Control Environment Configuration
# ==============================================================================

# [Proxmox VE API Configuration]
# Origin URL of your Proxmox VE API (e.g., https://pve.example.com:8006)
PROXMOX_BASE_URL=https://pve.example.com:8006
# API Token Identifier (Format: user@realm!token-name)
PROXMOX_TOKEN_ID=root@pam!token-name
# API Token Secret (Generated in Proxmox VE Datacenter -> API Tokens)
PROXMOX_TOKEN_SECRET=placeholder-token-secret
# Set to 'true' to use realistic offline simulation mock (useful when PVE is unreachable)
PROXMOX_MOCK_MODE=true

# [LLM & LangGraph Configuration]
# API Key for LLM (OpenAI API key, or custom token for private LLM endpoint)
LLM_API_KEY=your-api-key-here
# Custom OpenAI-compatible endpoint URL (e.g., https://api.openai.com/v1 or leave commented for OpenAI)
LLM_BASE_URL=https://api.openai.com/v1
# LLM Model Name (e.g., gpt-4o, gpt-4o-mini, or custom self-hosted model)
LLM_MODEL=gpt-4o-mini

# [Backend Services Configuration]
PORT=3010
GATEWAY_PORT=3000
INFRA_SERVICE_URL=http://localhost:3010

# [Redis & Distributed Lock / ShedLock]
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# [RabbitMQ Event Bus]
RABBITMQ_URI=amqp://guest:guest@localhost:5672

# [Frontend Configuration]
NEXT_PUBLIC_API_BASE_URL=http://localhost:3010
